// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Uses the POOLED connection (App)
  directUrl = env("DIRECT_URL")   // Uses the DIRECT connection (Migrations)
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  name     String?
  password String
  items    Item[]
}

model Item {
  id               Int      @id @default(autoincrement())
  longDescription  String
  shortDescription String
  name             String
  image            String   @db.Text
  price            Decimal
  promoPrice       Decimal?
  user             User     @relation(fields: [userId], references: [id])
  userId           Int
}